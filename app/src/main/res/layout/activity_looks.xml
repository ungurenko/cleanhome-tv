<?xml version="1.0" encoding="utf-8"?>
<!-- Looks: three ready-made looks of Home as live miniatures, one OK each; small choices in a row of chips. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="72dp"
    android:paddingEnd="72dp"
    android:paddingTop="48dp"
    android:paddingBottom="40dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/looks_title"
        android:textColor="#FFF4F8FB"
        android:textSize="30sp"
        android:fontFamily="@string/font_light"
        android:letterSpacing="-0.01" />

    <LinearLayout
        android:id="@+id/lookCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/chipWallpaper" style="@style/LooksChip" />
        <TextView android:id="@+id/chipClock" style="@style/LooksChip" />
        <TextView android:id="@+id/chipMotion" style="@style/LooksChip" />
        <TextView android:id="@+id/chipFineTune" style="@style/LooksChip" android:text="@string/looks_fine_tune_chip" />
        <TextView android:id="@+id/chipTv" style="@style/LooksChip" android:text="@string/looks_tv_chip" />
    </LinearLayout>
</LinearLayout>
